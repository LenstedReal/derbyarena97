; Engine configuration file.
; Godot 4.7.2 Stable — Derby Arena 1.0.5

config_version=5

[application]

config/name="Derby Arena"
config/description="Derby Arena 1.0.5 — 3D mobile car-combat arena with vehicles, weapons and powerups."
config/version="1.0.5"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/autoload/settings.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="player_shot"
3d_physics/layer_5="enemy_shot"

[physics]

common/physics_ticks_per_second=60
common/physics_jitter_fix=0.5

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
scaling_3d/mode=0
scaling_3d/scale=0.85
